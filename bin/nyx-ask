#!/usr/bin/env python3
"""Ask Nyx something. Runs an AI coding agent CLI in non-interactive mode and
prints one JSON object on stdout:
{"ok": bool, "reply": str, "mood": str, "action": {...}|null, "brain": str}.

  echo "how's my battery?" | nyx-ask
  nyx-ask --reset                  # forget the conversation
  echo "context" | nyx-ask --quip  # one unprompted one-liner (separate, not saved)

The message is read from stdin, never from the command line, so other users
on the machine can't see it in `ps` or /proc/<pid>/cmdline.

Settings (optional) in ~/.config/nyx/config.json:
  {"brain": "claude"}                  # or "codex"
  {"brain": "claude", "model": "sonnet"}
"""
import ctypes
import fcntl
import glob
import json
import random
import re
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import unicodedata
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "nyx"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "nyx/config.json"
TIMEOUT = 180

# Defaults picked by benchmark (docs/benchmarks.md): smartest models that stay fast.
DEFAULT_MODEL = {"claude": "sonnet", "codex": "gpt-6.1-terra"}
DEFAULT_EFFORT = "low"

MOODS = ["happy", "curious", "worried", "sleepy", "proud", "neutral"]

# Strict enough for OpenAI structured outputs, fine for Claude too.
SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "properties": {
        "reply": {"type": "string"},
        "mood": {"type": "string", "enum": ["happy", "curious", "worried", "sleepy", "proud", "neutral"]},
        "action": {
            "type": ["object", "null"],
            "additionalProperties": False,
            "properties": {"command": {"type": "string"}, "label": {"type": "string"}},
            "required": ["command", "label"],
        },
    },
    "required": ["reply", "mood", "action"],
}

# Fixed, read-only lookups. Claude reaches them only through bin/nyx-mcp (it
# has no shell); Codex runs nyx-look inside its read-only sandbox.
LOOK = HERE / "bin/nyx-look"
MCP = HERE / "bin/nyx-mcp"

# Folders Claude may read. Only the parts of ~/.config that matter for the
# desktop, so tokens and browser profiles (gh, chromium, ...) stay out of reach.
CONFIG_DIRS = ["hypr", "omarchy", "alacritty", "foot", "kitty", "ghostty", "btop", "fastfetch", "nvim",
               "mako", "walker", "elephant", "waybar", "swayosd", "uwsm", "environment.d", "autostart",
               "fontconfig", "gtk-3.0", "gtk-4.0", "mpv", "imv", "tmux", "lazygit", "wireplumber",
               "xdg-desktop-portal", "systemd", "nyx"]
SYSTEM_DIRS = ["/usr/share/omarchy", "/etc", "/sys/class/power_supply", "/sys/class/thermal", "/sys/class/hwmon",
               "/sys/class/backlight", str(HOME / ".local/state/omarchy")]

SAFE_VALUE = re.compile(r"^[A-Za-z0-9._:\-\[\]]{1,64}$")  # model / effort names from config.json


def die_with_parent():
    """Child processes get SIGTERM if nyx-ask goes away (New chat, shell restart)."""
    ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG


class BrainError(Exception):
    pass


def out(ok, reply, mood="neutral", action=None, brain=""):
    print(json.dumps({"ok": ok, "reply": reply, "mood": mood, "action": action, "brain": brain}))
    sys.exit(0)


def find_bin(name, patterns):
    found = shutil.which(name)
    if found:
        return found
    for pattern in patterns:
        hits = sorted(glob.glob(os.path.expanduser(pattern)))
        if hits:
            return hits[-1]
    return None


def session_file(brain):
    return STATE / f"session-{brain}"


def system_prompt(brain):
    if brain == "claude":
        how = "Use your `look` tool (its description lists the topics). You have no shell."
    else:
        topics = subprocess.run([str(LOOK), "help"], capture_output=True, text=True).stdout.strip()
        how = f"Run `{LOOK} <topic> [arg]`. Topics:\n```\n{topics}\n```"
    return (HERE / "prompt.md").read_text() + f"\n# Looking things up\n{how}\n"


def readable_dirs():
    config = HOME / ".config"
    return [d for d in SYSTEM_DIRS + [str(config / c) for c in CONFIG_DIRS] if os.path.isdir(d)]


# Codex gets config folders of its own (one for chat, one for small talk),
# sharing only the login. The user's config.toml, rules, MCP servers, hooks and
# skills never load: a user "allow" rule, for example, would otherwise run
# commands outside the sandbox.
#
# Features: everything Codex turns on by default is switched off except the
# plumbing below, so new features in future Codex versions start off too.
CODEX_KEEP = {"api_key_cyber_access_programs", "api_key_model_discovery", "cli_daybreak", "code_mode_host",
              "code_mode_interrupt", "compaction_image_budget", "content_item_kinds", "enable_request_compression",
              "fast_mode", "incremental_tools", "instant_interrupt", "mentions_v2", "prediction_preserve_parent_tools",
              "reasoning_effort_override", "shell_snapshot", "shell_tool", "system_proxy_fallback", "ultrafast_mode",
              "unbounded_connection_retries", "unified_exec", "unified_exec_tty", "write_stdin_approval"}
# Small talk can't run or read anything.
CODEX_TOOLS = {"shell_tool", "shell_snapshot", "unified_exec", "unified_exec_tty", "write_stdin_approval",
               "code_mode_host", "code_mode_interrupt"}


def codex_home(codex, quiet):
    home = STATE / ("codex-quiet" if quiet else "codex")
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(home, 0o700)
    real = Path(os.environ.get("CODEX_HOME") or HOME / ".codex") / "auth.json"
    sync_codex_login(home, real)
    (home / "config.toml").write_text(codex_config(codex, quiet))
    return home, real


def codex_config(codex, quiet):
    """A permission profile: `nyx` reads what Claude can (plus what nyx-look
    needs), small talk reads nothing private. No writes, no network. Codex runs
    with --strict-config, so one that doesn't understand this refuses to start
    instead of ignoring it."""
    exe = Path(codex).resolve()
    paths = [exe.parent] + ([exe.parent.parent] if "codex" in str(exe.parent.parent) else [])
    if not quiet:
        paths += readable_dirs() + [str(LOOK.parent)]
        paths += [d for d in ("/sys", "/var/lib/pacman", "/var/log/journal", "/run/log/journal") if os.path.isdir(d)]
    paths = list(dict.fromkeys(map(str, paths)))
    lines = ['default_permissions = "nyx"', 'approval_policy = "never"', 'web_search = "disabled"',
             "allow_login_shell = false", "", "[permissions.nyx.filesystem]", '":minimal" = "read"']
    lines += [f'{json.dumps(p)} = "read"' for p in paths]
    # Symlinks inside the readable folders must not open up what they point to.
    lines += [f'{json.dumps(p)} = "deny"' for p in escaping_links(paths)]  # (link targets)
    lines += ["", "[permissions.nyx.network]", "enabled = false", "", "[features]"]
    keep = CODEX_KEEP - (CODEX_TOOLS if quiet else set())
    lines += [f"{name} = false" for name in sorted(codex_features(codex) - keep)]
    return "\n".join(lines) + "\n"


def escaping_links(roots, depth=4):
    """Where symlinks under the user's readable folders lead, when that's
    somewhere else in the home folder (a plugin linked from ~/Work, say)."""
    allowed = [os.path.realpath(r) for r in roots]
    inside = lambda t: any(t == a or t.startswith(a.rstrip("/") + "/") for a in allowed)
    found = []
    for root in roots:
        if not root.startswith(str(HOME)):
            continue  # system folders: their links go to other system files
        base = root.count(os.sep)
        for dirpath, dirs, files in os.walk(root):
            if dirpath.count(os.sep) - base >= depth:
                dirs[:] = []
            for name in dirs + files:
                full = os.path.join(dirpath, name)
                target = os.path.realpath(full)
                if (os.path.islink(full) and target.startswith(str(HOME) + "/") and not inside(target)
                        and not any(a.startswith(target + "/") for a in allowed)):  # e.g. Nyx's own folder
                    found.append(target)
    return list(dict.fromkeys(found))


def codex_features(codex):
    """Names of the features this Codex turns on by default."""
    exe = Path(codex).resolve()
    cache = STATE / "codex-features.json"
    key = f"{exe}:{exe.stat().st_mtime}"
    try:
        data = json.loads(cache.read_text())
        if data.get("key") == key and data["on"]:
            return set(data["on"])
    except (OSError, ValueError, KeyError):
        pass
    out = subprocess.run([codex, "features", "list"], capture_output=True, text=True, timeout=30).stdout
    on = [line.split()[0] for line in out.splitlines() if len(line.split()) >= 3 and line.split()[-1] == "true"]
    if not on or "shell_tool" not in on:
        # Can't tell what's switched on, so don't run at all.
        raise BrainError("I couldn't check which Codex features are on, so I won't use Codex. Is it up to date?")
    cache.write_text(json.dumps({"key": key, "on": on}))
    return set(on)


def sync_codex_login(home, real):
    link = home / "auth.json"
    if link.exists() and not link.is_symlink():
        # Codex refreshed the login and saved a new file in place of the link.
        # Copy the fresh tokens back (only if they're newer) so the user's own
        # Codex stays logged in.
        if not real.exists() or link.stat().st_mtime > real.stat().st_mtime:
            shutil.copyfile(link, real)
            os.chmod(real, 0o600)
        link.unlink()
    if link.is_symlink() and os.readlink(link) != str(real):
        link.unlink()  # CODEX_HOME moved
    if not link.is_symlink():
        link.symlink_to(real)


# ------------------------------------------------------------------ claude
def ask_claude(message, model, effort, session, tools=True):
    claude = find_bin("claude", ["~/.local/bin/claude", "~/.local/share/mise/installs/claude/*/claude",
                                 "~/.local/share/mise/shims/claude", "~/.claude/local/claude"])
    if not claude:
        raise BrainError("I can't find Claude Code (the `claude` command), so I have no brain right now.")

    # An empty folder of its own, so no project settings get picked up.
    workdir = STATE / "claude"
    workdir.mkdir(parents=True, exist_ok=True)

    def run(sess):
        cmd = [
            claude, "-p",  # prompt comes on stdin, not argv
            "--model", model or DEFAULT_MODEL["claude"],
            "--effort", effort or DEFAULT_EFFORT,
            "--output-format", "json",
            "--json-schema", json.dumps(SCHEMA),
            "--append-system-prompt", system_prompt("claude"),
            # Locked down no matter what the user's own Claude Code settings say:
            "--restricted",                   # no shell or other code-running tools, no settings
                                              # files, file tools confined to the folders below
            "--permission-mode", "dontAsk",   # anything not allowed here is refused, never asked
            "--setting-sources", "",          # (also) ignore the user's allow rules, hooks, plugins
            "--settings", json.dumps({"permissions": {"blockReadsOutsideWorkingDirectories": True}}),
            "--strict-mcp-config",            # only Nyx's own tool server below
            "--disable-slash-commands",       # no skills
        ]
        if tools:
            # No shell: Claude can read files in the folders below and call one
            # tool, `look` (bin/nyx-mcp -> bin/nyx-look). Nothing else.
            cmd += ["--tools", "Read,Grep,Glob",
                    "--mcp-config", json.dumps({"mcpServers": {"nyx": {"command": str(MCP), "args": []}}}),
                    "--allowedTools", "mcp__nyx__look",
                    "--add-dir", *readable_dirs()]
        else:
            cmd += ["--tools", "", "--no-session-persistence"]  # small talk: no tools, not saved
        if sess:
            cmd += ["--resume", sess]
        return subprocess.run(cmd, cwd=workdir, capture_output=True, text=True, timeout=TIMEOUT,
                              input=message, preexec_fn=die_with_parent)

    proc = run(session)
    if proc.returncode != 0 and session:
        proc = run("")  # old session gone? start fresh
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        err = (proc.stderr or proc.stdout or "no output").strip().splitlines()[-1:]
        raise BrainError("My brain glitched: " + " ".join(err)[:200])
    if data.get("is_error"):
        raise BrainError("Claude said: " + str(data.get("result", "error"))[:200])
    result = data.get("structured_output")
    if not isinstance(result, dict):
        result = parse_json(data.get("result") or "")
    return result, data.get("session_id", "")


# ------------------------------------------------------------------- codex
def ask_codex(message, model, effort, session, tools=True):
    codex = find_bin("codex", ["~/.local/share/mise/installs/codex/*/bin/codex", "~/.local/share/mise/shims/codex",
                               "~/.local/bin/codex", "~/.npm-global/bin/codex"])
    if not codex:
        raise BrainError("I can't find Codex (the `codex` command), so I have no brain right now.")

    # One Codex at a time, so two runs can't both touch the shared login.
    lock = open(STATE / "codex.lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    home, real_login = codex_home(codex, quiet=not tools)
    env = dict(os.environ, CODEX_HOME=str(home))
    workdir = STATE / "codex-work"
    workdir.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory(prefix="nyx-") as tmp:
        schema = Path(tmp) / "schema.json"
        schema.write_text(json.dumps(SCHEMA))
        last = Path(tmp) / "last.json"

        def run(sess, model=model):
            # Codex has no system-prompt flag, so a new chat starts with Nyx's rules.
            prompt = message if sess else system_prompt("codex") + "\n\n# The user says\n" + message
            opts = [
                # Profile and features come from Nyx's config.toml (see codex_config).
                "--json", "--skip-git-repo-check", "--strict-config",
                "--output-schema", str(schema), "-o", str(last),
                "-c", f'model_reasoning_effort="{effort or DEFAULT_EFFORT}"',
            ]
            if not tools:
                opts += ["--ephemeral"]  # small talk isn't saved
            if model:
                opts += ["-m", model]
            # "-" = read the prompt from stdin, so it never shows up in argv
            cmd = [codex, "exec", "resume", *opts, sess, "-"] if sess else [codex, "exec", *opts, "-"]
            try:
                return subprocess.run(cmd, cwd=workdir, env=env, capture_output=True, text=True,
                                      timeout=TIMEOUT, input=prompt, preexec_fn=die_with_parent)
            finally:
                sync_codex_login(home, real_login)

        user_model = model
        proc = run(session, user_model or DEFAULT_MODEL["codex"])
        if not last.exists() and not user_model:
            # Default model not on this account? Fall back to Codex's own default.
            proc = run(session, None)
        if not last.exists() and session:
            proc = run("", user_model or DEFAULT_MODEL["codex"])
        new_session = session
        errors = []
        for line in proc.stdout.splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            new_session = ev.get("thread_id") or ev.get("session_id") or new_session
            if ev.get("type") in ("error", "turn.failed"):
                errors.append(str(ev.get("message") or (ev.get("error") or {}).get("message") or ev))
        if not last.exists() or not last.read_text().strip():
            hint = errors[-1] if errors else (proc.stderr or "no output").strip().splitlines()[-1:]
            hint = hint if isinstance(hint, str) else " ".join(hint)
            if "login" in hint.lower() or "auth" in hint.lower() or "401" in hint:
                raise BrainError("Codex isn't logged in. Run `codex login` in a terminal, then try me again.")
            raise BrainError("Codex glitched: " + hint[:200])
        return parse_json(last.read_text()), new_session


def parse_json(text):
    text = text.strip()
    if text.startswith("```"):
        text = text.strip("`").split("\n", 1)[-1]
    try:
        return json.loads(text)
    except ValueError:
        return {"reply": text or "…", "mood": "neutral", "action": None}


BRAINS = {"claude": ask_claude, "codex": ask_codex}

QUIP_STYLES = [
    "a tiny joke about what they're doing",
    "a genuine little compliment",
    "a fun, true nerdy fact loosely related to the moment",
    "a playful observation about the time of day",
    "cheering them on like a hype buddy",
    "a cozy, calm vibe",
    "a gentle nudge to take care of themselves (water, eyes, posture)",
    "something about the music, if any is playing; otherwise a joke",
]

# Small talk uses the lightest model of each brain: it's one short line.
QUIP_MODEL = {"claude": "haiku", "codex": "gpt-6-luna"}
QUIP_PROMPT = """You're speaking up on your own, unprompted, in a tiny speech bubble in
the corner of the user's screen. Say ONE short line (max 14 words) that fits
this moment: {ctx}.
Style for this one: {style}. Keep it warm and specific to the moment. Don't ask them to do a task, don't offer actions, don't use
any tools, and don't start with "Hey". action must be null."""


def hidden(ch):
    """Characters that can make text look different from what it is: controls,
    newlines, bidi overrides, zero-width and other invisible format marks,
    unassigned code points, and whitespace other than a plain space."""
    cat = unicodedata.category(ch)
    return cat[0] == "C" or cat in ("Zl", "Zp") or (cat == "Zs" and ch != " ")


def clean_text(text, limit):
    """Reply text: keep newlines, turn tabs into spaces, drop anything hidden."""
    kept = ("\n" if c == "\n" else " " if c in "\t\r" else c for c in str(text))
    return "".join(c for c in kept if c == "\n" or not hidden(c)).strip()[:limit]


def clean_action(action):
    """Return (action, note). A command is shown on the Run card and run as-is,
    so it must be one plain line with nothing hidden in it."""
    if not isinstance(action, dict):
        return None, ""
    command, label = action.get("command"), action.get("label")
    if not isinstance(command, str) or not command.strip():
        return None, ""
    command = command.strip()
    if len(command) > 400 or any(hidden(c) for c in command):
        return None, " (I had a command for this, but it was too long or had hidden characters, so I dropped it.)"
    label = " ".join(clean_text(label if isinstance(label, str) else "", 80).split()) or "Run this?"
    return {"command": command, "label": label}, ""


def read_generation():
    try:
        return (STATE / "generation").read_text()
    except OSError:
        return ""


def forget_everything():
    """New chat: drop the sessions and the transcripts the CLIs keep for Nyx."""
    (STATE / "generation").write_text(str(time.time_ns()))
    for f in STATE.glob("session*"):
        f.unlink(missing_ok=True)
    claude_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
    transcripts = claude_dir / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(STATE / "claude"))
    with open(STATE / "codex.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        real_login = Path(os.environ.get("CODEX_HOME") or HOME / ".codex") / "auth.json"
        for d in (STATE / "codex", STATE / "codex-quiet"):
            if d.is_dir():
                sync_codex_login(d, real_login)  # keep a refreshed login before deleting
        for d in (transcripts, STATE / "codex", STATE / "codex-quiet"):
            if d.is_dir() and not d.is_symlink():
                shutil.rmtree(d)


def main():
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)  # chats, sessions and Codex's login link live here
    args = sys.argv[1:]
    if args and args[0] == "--reset":
        forget_everything()
        out(True, "Fresh start ✨", "happy")
    generation = read_generation()

    config = {}
    try:
        config = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        pass
    brain = str(config.get("brain", "claude")).lower()
    if brain not in BRAINS:
        out(False, f"I don't know the brain \"{brain}\". Use one of: {', '.join(BRAINS)}.", "worried")
    model = config.get("model")
    effort = config.get("effort")
    for key, value in (("model", model), ("effort", effort), ("quipModel", config.get("quipModel"))):
        if value is not None and not SAFE_VALUE.match(str(value)):
            out(False, f"The {key} \"{value}\" in ~/.config/nyx/config.json doesn't look right.", "worried")

    # Private text arrives on stdin only (see the docstring).
    text = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read().strip()
    quip = bool(args) and args[0] == "--quip"
    if quip:
        message = QUIP_PROMPT.format(ctx=text or "an ordinary moment",
                                     style=random.choice(QUIP_STYLES))
        model = config.get("quipModel") or QUIP_MODEL[brain]
        sfile, session = None, ""          # throwaway: never touches the chat
    else:
        message = text
        if not message:
            out(False, "Say something to me!")
        sfile = session_file(brain)
        session = sfile.read_text().strip() if sfile.exists() else ""
    try:
        # Small talk gets no tools at all: it only needs to say one line.
        result, new_session = BRAINS[brain](message, model, effort, session, tools=not quip)
    except subprocess.TimeoutExpired:
        out(False, "That took way too long, I gave up. Try again?", "worried", brain=brain)
    except BrainError as e:
        out(False, str(e), "worried", brain=brain)

    # Skip if the chat was reset while this answer was on its way.
    if new_session and sfile and read_generation() == generation:
        sfile.write_text(new_session)
    if not isinstance(result, dict):
        result = {"reply": str(result)}
    action, note = (None, "") if quip else clean_action(result.get("action"))
    reply = clean_text(result.get("reply") or "…", 2000) + note
    mood = result.get("mood") if result.get("mood") in MOODS else "neutral"
    out(True, reply, mood, action, brain)


if __name__ == "__main__":
    main()

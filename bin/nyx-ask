#!/usr/bin/env python3
"""Ask Nyx something. Runs an AI coding agent CLI in non-interactive mode and
prints one JSON object on stdout:
{"ok": bool, "reply": str, "mood": str, "action": {...}|null, "brain": str}.

  echo "how's my battery?" | nyx-ask
  nyx-ask --reset                  # forget the conversation
  echo "context" | nyx-ask --quip  # one unprompted one-liner (separate, not saved)

The message is read from stdin, never from the command line, so other users
on the machine can't see it in `ps` or /proc/<pid>/cmdline.

Settings (optional) in ~/.config/nyx/config.json:
  {"brain": "claude"}                  # or "codex"
  {"brain": "claude", "model": "sonnet"}
"""
import glob
import json
import random
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "nyx"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "nyx/config.json"
TIMEOUT = 180

# Defaults picked by benchmark (docs/benchmarks.md): smartest models that stay fast.
DEFAULT_MODEL = {"claude": "sonnet", "codex": "gpt-6.1-terra"}
DEFAULT_EFFORT = "low"

# Strict enough for OpenAI structured outputs, fine for Claude too.
SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "properties": {
        "reply": {"type": "string"},
        "mood": {"type": "string", "enum": ["happy", "curious", "worried", "sleepy", "proud", "neutral"]},
        "action": {
            "type": ["object", "null"],
            "additionalProperties": False,
            "properties": {"command": {"type": "string"}, "label": {"type": "string"}},
            "required": ["command", "label"],
        },
    },
    "required": ["reply", "mood", "action"],
}

# Claude: read-only commands Nyx may run on its own. Anything else is denied,
# so changes always come back as an `action` the user approves.
READ_ONLY = [
    "Read", "Grep", "Glob",
    "Bash(ps:*)", "Bash(free:*)", "Bash(df:*)", "Bash(du:*)", "Bash(uptime:*)", "Bash(uname:*)",
    "Bash(lscpu:*)", "Bash(lsblk:*)", "Bash(lsusb:*)", "Bash(lspci:*)", "Bash(ip addr:*)", "Bash(ip route:*)",
    "Bash(nmcli device status:*)", "Bash(nmcli connection show:*)", "Bash(nmcli -t:*)",
    "Bash(upower:*)", "Bash(sensors:*)", "Bash(top -bn1:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)",
    "Bash(ls:*)", "Bash(wc:*)", "Bash(date:*)", "Bash(whoami:*)", "Bash(hostnamectl:*)", "Bash(fastfetch:*)",
    "Bash(journalctl:*)", "Bash(systemctl status:*)", "Bash(systemctl --user status:*)",
    "Bash(systemctl list-units:*)", "Bash(systemctl --user list-units:*)",
    "Bash(pacman -Q:*)", "Bash(pacman -Si:*)", "Bash(pacman -Ss:*)", "Bash(wpctl status:*)", "Bash(wpctl get-volume:*)",
    "Bash(brightnessctl info:*)", "Bash(brightnessctl get:*)", "Bash(powerprofilesctl get:*)", "Bash(powerprofilesctl list:*)",
    "Bash(hyprctl clients:*)", "Bash(hyprctl monitors:*)", "Bash(hyprctl activewindow:*)", "Bash(hyprctl workspaces:*)",
    "Bash(hyprctl activeworkspace:*)", "Bash(hyprctl getoption:*)", "Bash(hyprctl devices:*)", "Bash(hyprctl version:*)",
    "Bash(hyprctl hyprsunset temperature:*)",
    "Bash(omarchy commands:*)", "Bash(omarchy version:*)", "Bash(omarchy theme current:*)", "Bash(omarchy theme list:*)",
    "Bash(omarchy font current:*)", "Bash(omarchy font list:*)", "Bash(omarchy plugin list:*)",
    "Bash(omarchy menu keybindings --print:*)", "Bash(omarchy reminder show:*)",
]


class BrainError(Exception):
    pass


def out(ok, reply, mood="neutral", action=None, brain=""):
    print(json.dumps({"ok": ok, "reply": reply, "mood": mood, "action": action, "brain": brain}))
    sys.exit(0)


def find_bin(name, patterns):
    found = shutil.which(name)
    if found:
        return found
    for pattern in patterns:
        hits = sorted(glob.glob(os.path.expanduser(pattern)))
        if hits:
            return hits[-1]
    return None


def session_file(brain):
    return STATE / f"session-{brain}"


# ------------------------------------------------------------------ claude
def ask_claude(message, model, effort, session):
    claude = find_bin("claude", ["~/.local/bin/claude", "~/.local/share/mise/installs/claude/*/claude",
                                 "~/.local/share/mise/shims/claude", "~/.claude/local/claude"])
    if not claude:
        raise BrainError("I can't find Claude Code (the `claude` command), so I have no brain right now.")

    def run(sess):
        cmd = [
            claude, "-p",  # prompt comes on stdin, not argv
            "--model", model or DEFAULT_MODEL["claude"],
            "--effort", effort or DEFAULT_EFFORT,
            "--output-format", "json",
            "--json-schema", json.dumps(SCHEMA),
            "--append-system-prompt", (HERE / "prompt.md").read_text(),
            "--tools", "Bash,Read,Grep,Glob",
            "--allowedTools", *READ_ONLY,
            # Read-only places Nyx may look: Omarchy's files, system config, and
            # the kernel's battery/temperature readouts.
            "--add-dir", "/usr/share/omarchy", "/etc", str(HOME / ".config"),
            "/sys/class/power_supply", "/sys/class/thermal", "/sys/class/hwmon",
        ]
        if sess:
            cmd += ["--resume", sess]
        return subprocess.run(cmd, cwd=HOME, capture_output=True, text=True, timeout=TIMEOUT,
                              input=message)

    proc = run(session)
    if proc.returncode != 0 and session:
        proc = run("")  # old session gone? start fresh
    try:
        data = json.loads(proc.stdout)
    except ValueError:
        err = (proc.stderr or proc.stdout or "no output").strip().splitlines()[-1:]
        raise BrainError("My brain glitched: " + " ".join(err)[:200])
    if data.get("is_error"):
        raise BrainError("Claude said: " + str(data.get("result", "error"))[:200])
    result = data.get("structured_output")
    if not isinstance(result, dict):
        result = parse_json(data.get("result") or "")
    return result, data.get("session_id", "")


# ------------------------------------------------------------------- codex
def ask_codex(message, model, effort, session):
    codex = find_bin("codex", ["~/.local/share/mise/installs/codex/*/bin/codex", "~/.local/share/mise/shims/codex",
                               "~/.local/bin/codex", "~/.npm-global/bin/codex"])
    if not codex:
        raise BrainError("I can't find Codex (the `codex` command), so I have no brain right now.")

    with tempfile.TemporaryDirectory(prefix="nyx-") as tmp:
        schema = Path(tmp) / "schema.json"
        schema.write_text(json.dumps(SCHEMA))
        last = Path(tmp) / "last.json"

        def run(sess, model=model):
            # Codex has no system-prompt flag, so a new chat starts with Nyx's rules.
            prompt = message if sess else (HERE / "prompt.md").read_text() + "\n\n# The user says\n" + message
            opts = [
                "--json", "--skip-git-repo-check",
                "--output-schema", str(schema), "-o", str(last),
                # read-only sandbox: Codex can look around but cannot change anything
                "-c", 'sandbox_mode="read-only"', "-c", 'approval_policy="never"',
                "-c", f'model_reasoning_effort="{effort or DEFAULT_EFFORT}"',
            ]
            if model:
                opts += ["-m", model]
            # "-" = read the prompt from stdin, so it never shows up in argv
            cmd = [codex, "exec", "resume", *opts, sess, "-"] if sess else [codex, "exec", *opts, "-"]
            return subprocess.run(cmd, cwd=HOME, capture_output=True, text=True, timeout=TIMEOUT,
                                  input=prompt)

        user_model = model
        proc = run(session, user_model or DEFAULT_MODEL["codex"])
        if not last.exists() and not user_model:
            # Default model not on this account? Fall back to Codex's own default.
            proc = run(session, None)
        if not last.exists() and session:
            proc = run("", user_model or DEFAULT_MODEL["codex"])
        new_session = session
        errors = []
        for line in proc.stdout.splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            new_session = ev.get("thread_id") or ev.get("session_id") or new_session
            if ev.get("type") in ("error", "turn.failed"):
                errors.append(str(ev.get("message") or (ev.get("error") or {}).get("message") or ev))
        if not last.exists() or not last.read_text().strip():
            hint = errors[-1] if errors else (proc.stderr or "no output").strip().splitlines()[-1:]
            hint = hint if isinstance(hint, str) else " ".join(hint)
            if "login" in hint.lower() or "auth" in hint.lower() or "401" in hint:
                raise BrainError("Codex isn't logged in. Run `codex login` in a terminal, then try me again.")
            raise BrainError("Codex glitched: " + hint[:200])
        return parse_json(last.read_text()), new_session


def parse_json(text):
    text = text.strip()
    if text.startswith("```"):
        text = text.strip("`").split("\n", 1)[-1]
    try:
        return json.loads(text)
    except ValueError:
        return {"reply": text or "…", "mood": "neutral", "action": None}


BRAINS = {"claude": ask_claude, "codex": ask_codex}

QUIP_STYLES = [
    "a tiny joke about what they're doing",
    "a genuine little compliment",
    "a fun, true nerdy fact loosely related to the moment",
    "a playful observation about the time of day",
    "cheering them on like a hype buddy",
    "a cozy, calm vibe",
    "a gentle nudge to take care of themselves (water, eyes, posture)",
    "something about the music, if any is playing; otherwise a joke",
]

# Small talk uses the lightest model of each brain: it's one short line.
QUIP_MODEL = {"claude": "haiku", "codex": "gpt-6-luna"}
QUIP_PROMPT = """You're speaking up on your own, unprompted, in a tiny speech bubble in
the corner of the user's screen. Say ONE short line (max 14 words) that fits
this moment: {ctx}.
Style for this one: {style}. Keep it warm and specific to the moment. Don't ask them to do a task, don't offer actions, don't use
any tools, and don't start with "Hey". action must be null."""


def main():
    STATE.mkdir(parents=True, exist_ok=True)
    args = sys.argv[1:]
    if args and args[0] == "--reset":
        for f in STATE.glob("session*"):
            f.unlink(missing_ok=True)
        out(True, "Fresh start ✨", "happy")

    config = {}
    try:
        config = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        pass
    brain = str(config.get("brain", "claude")).lower()
    if brain not in BRAINS:
        out(False, f"I don't know the brain \"{brain}\". Use one of: {', '.join(BRAINS)}.", "worried")
    model = config.get("model")
    effort = config.get("effort")

    # Private text arrives on stdin only (see the docstring).
    text = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read().strip()
    quip = bool(args) and args[0] == "--quip"
    if quip:
        message = QUIP_PROMPT.format(ctx=text or "an ordinary moment",
                                     style=random.choice(QUIP_STYLES))
        model = config.get("quipModel") or QUIP_MODEL[brain]
        sfile, session = None, ""          # throwaway: never touches the chat
    else:
        message = text
        if not message:
            out(False, "Say something to me!")
        sfile = session_file(brain)
        session = sfile.read_text().strip() if sfile.exists() else ""
    try:
        result, new_session = BRAINS[brain](message, model, effort, session)
    except subprocess.TimeoutExpired:
        out(False, "That took way too long, I gave up. Try again?", "worried", brain=brain)
    except BrainError as e:
        out(False, str(e), "worried", brain=brain)

    if new_session and sfile:
        sfile.write_text(new_session)
    action = result.get("action")
    if not (isinstance(action, dict) and action.get("command")):
        action = None
    out(True, result.get("reply", "…"), result.get("mood", "neutral"), action, brain)


if __name__ == "__main__":
    main()
